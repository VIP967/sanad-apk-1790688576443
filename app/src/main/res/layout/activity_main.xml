<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Screen Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="@color/surface"
        android:orientation="vertical"
        android:padding="16dlp"
        android:gravity="bottom"
        android:layout_marginBottom="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvExpression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="@color/text_secondary"
                android:textSize="24sp"
                android:maxLines="1"
                tools:text="50 * 3 + sin(30)" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="@color/text_primary"
                android:textSize="48sp"
                android:textStyle="bold"
                android:maxLines="1"
                tools:text="150.5" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Keypad Layout -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:columnCount="4"
        android:rowCount="6"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false">

        <!-- Row 1: Advanced Functions -->
        <Button style="@style/CalcFuncButtonStyle" android:id="@+id/btnSin" android:text="@string/btn_sin" />
        <Button style="@style/CalcFuncButtonStyle" android:id="@+id/btnCos" android:text="@string/btn_cos" />
        <Button style="@style/CalcFuncButtonStyle" android:id="@+id/btnTan" android:text="@string/btn_tan" />
        <Button style="@style/CalcFuncButtonStyle" android:id="@+id/btnClear" android:text="@string/btn_ac" />

        <!-- Row 2: Advanced Functions -->
        <Button style="@style/CalcFuncButtonStyle" android:id="@+id/btnLog" android:text="@string/btn_log" />
        <Button style="@style/CalcFuncButtonStyle" android:id="@+id/btnLn" android:text="@string/btn_ln" />
        <Button style="@style/CalcFuncButtonStyle" android:id="@+id/btnSqrt" android:text="@string/btn_sqrt" />
        <Button style="@style/CalcFuncButtonStyle" android:id="@+id/btnPow" android:text="@string/btn_pow" />

        <!-- Row 3: Brackets, Pi, Divide -->
        <Button style="@style/CalcFuncButtonStyle" android:id="@+id/btnLeftParen" android:text="@string/btn_lparen" />
        <Button style="@style/CalcFuncButtonStyle" android:id="@+id/btnRightParen" android:text="@string/btn_rparen" />
        <Button style="@style/CalcFuncButtonStyle" android:id="@+id/btnPi" android:text="@string/btn_pi" />
        <Button style="@style/CalcOperatorButtonStyle" android:id="@+id/btnDiv" android:text="@string/btn_div" />

        <!-- Row 4: 7, 8, 9, Multiply -->
        <Button style="@style/CalcNumButtonStyle" android:id="@+id/btn7" android:text="7" />
        <Button style="@style/CalcNumButtonStyle" android:id="@+id/btn8" android:text="8" />
        <Button style="@style/CalcNumButtonStyle" android:id="@+id/btn9" android:text="9" />
        <Button style="@style/CalcOperatorButtonStyle" android:id="@+id/btnMul" android:text="@string/btn_mul" />

        <!-- Row 5: 4, 5, 6, Subtract -->
        <Button style="@style/CalcNumButtonStyle" android:id="@+id/btn4" android:text="4" />
        <Button style="@style/CalcNumButtonStyle" android:id="@+id/btn5" android:text="5" />
        <Button style="@style/CalcNumButtonStyle" android:id="@+id/btn6" android:text="6" />
        <Button style="@style/CalcOperatorButtonStyle" android:id="@+id/btnSub" android:text="@string/btn_sub" />

        <!-- Row 6: 1, 2, 3, Add -->
        <Button style="@style/CalcNumButtonStyle" android:id="@+id/btn1" android:text="1" />
        <Button style="@style/CalcNumButtonStyle" android:id="@+id/btn2" android:text="2" />
        <Button style="@style/CalcNumButtonStyle" android:id="@+id/btn3" android:text="3" />
        <Button style="@style/CalcOperatorButtonStyle" android:id="@+id/btnAdd" android:text="@string/btn_add" />

        <!-- Row 7: 0, Dot, Equal -->
        <Button style="@style/CalcNumButtonStyle" android:id="@+id/btn0" android:text="0" android:layout_columnSpan="2" android:layout_width="0dp" />
        <Button style="@style/CalcNumButtonStyle" android:id="@+id/btnDot" android:text="@string/btn_dot" />
        <Button style="@style/CalcEqualButtonStyle" android:id="@+id/btnEqual" android:text="@string/btn_eq" />

    </GridLayout>

</LinearLayout>